{% extends 'base.html.twig' %}

{% block title %}Votre Championnat de {{ country.championship }} {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="col-10 -auto mx-auto">

	

        <div class="row m-4">
            
                    <div class="col-12 text-center">

              

							
					</div>

						
							<div class="row g-0">
								<div class="col-md-4 text-center">
								<img src="{{country.championship_logo}}" class="img-fluid mt-2 rounded-start" id="championship_logo">
								</div>
								<div class="col-md-4 text-center p-4">
									<h2 class="text-align-center fw-bolder">Tous les clubs de {{ country.championship }} :</h2>	
								</div>
								<div class="col-md-4 text-center">								
									<img src="{{country.flag}}" width="50" height="50" class="d-inline-block mb-2 align-text-top">
									<h5 class="card-title">{{ country.championship }}</h5>								
								</div>
								
							</div>
						

						<table class="table align-items-center">
							<thead>
								<tr>
									<div class="container-fluid">
										<a class="navbar-brand" href="#"></a>
										
										<h3 class="mb-1 fw-bolder"></h3>										
										<img src=""class="img-fluid">
									</div>
								
								</tr>								
							</thead>
							<thead>
								<tr>
								<th scope="col">#</th>
								<th scope="col">First</th>
								<th scope="col">Last</th>
								<th scope="col">Handle</th>
								</tr>
							</thead>
							<tbody>
								<tr>
								<th scope="row">1</th>
								<td>Mark</td>
								<td>Otto</td>
								<td>@mdo</td>
								</tr>
								<tr>
								<th scope="row">2</th>
								<td>Jacob</td>
								<td>Thornton</td>
								<td>@fat</td>
								</tr>
								<tr>
								<th scope="row">3</th>
								<td colspan="2">Larry the Bird</td>
								<td>@twitter</td>
								</tr>
							</tbody>
							</table>
                        
			</div>
   
</div>
{% endblock %}
