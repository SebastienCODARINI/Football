{% extends 'base.html.twig' %}

{% block title %}Votre Championnat de {{ country.championship }} {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="col-10 -auto mx-auto">

	

        <div class="row m-4">
            <div class="col-12 text-center">

                <div class="row g-0 border rounded overflow-hidden flex-md-row align-items-start mb-4 shadow-sm position-relative">
                    

                    <div class="col-2 p-4 bg-light">
							
					</div>

						<table class="table">
							<thead>
								
									<div class="container-fluid">
										<a class="navbar-brand" href="#"></a>
										<img src="{{country.flag}}" alt="Logo" width="50" height="50" class="d-inline-block mb-2 align-text-top">
										<h3 class="mb-1 fw-bolder">{{ country.championship }}</h3>										
										
										<img src="{{country.championship_logo}}"class="img-fluid">

									</div>
									
								<tr>
								<th scope="col"></th>
								<th scope="col"></strong></th>
								<th scope="col"></th>
								<th scope="col"><div class="mb-1 text-muted"><img src=class="img-fluid"></div></th>
								</tr>								
							</thead>
							<thead>
								<tr>
								<th scope="col">#</th>
								<th scope="col">First</th>
								<th scope="col">Last</th>
								<th scope="col">Handle</th>
								</tr>
							</thead>
							<tbody>
								<tr>
								<th scope="row">1</th>
								<td>Mark</td>
								<td>Otto</td>
								<td>@mdo</td>
								</tr>
								<tr>
								<th scope="row">2</th>
								<td>Jacob</td>
								<td>Thornton</td>
								<td>@fat</td>
								</tr>
								<tr>
								<th scope="row">3</th>
								<td colspan="2">Larry the Bird</td>
								<td>@twitter</td>
								</tr>
							</tbody>
							</table>
                        
			</div>
   
</div>
{% endblock %}
